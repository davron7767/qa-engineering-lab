# QA Commerce - local configuration template.
# Copy to .env (Copy-Item .env.example .env). Every value here is a LOCAL-ONLY placeholder.
# Never put real credentials in this file or in .env.

# --- Application ---
APP_ENV=development
APP_HOST_PORT=8000
# Signs CSRF tokens. Any long random string works locally; production refuses this placeholder.
SECRET_KEY=local-dev-only-change-me-0123456789abcdef
SESSION_TTL_MINUTES=60
# Cookies are sent over plain HTTP locally. Set true behind HTTPS.
COOKIE_SECURE=false

# --- Database (Docker Compose service "db", published on the host at POSTGRES_HOST_PORT) ---
POSTGRES_USER=qa_commerce
POSTGRES_PASSWORD=qa_commerce_local
POSTGRES_DB=qa_commerce
POSTGRES_HOST_PORT=5433
# Used by the app when it runs directly on the host (outside Docker).
DATABASE_URL=postgresql+psycopg://qa_commerce:qa_commerce_local@localhost:5433/qa_commerce
# Dedicated database for backend integration tests. Its name MUST end in "_test":
# the reset helpers refuse to touch any other database.
TEST_DATABASE_URL=postgresql+psycopg://qa_commerce:qa_commerce_local@localhost:5433/qa_commerce_test

# --- Seed data (synthetic, local-only accounts) ---
SEED_ON_STARTUP=true
SEED_ADMIN_PASSWORD=Admin#Local2024
SEED_CUSTOMER_PASSWORD=Customer#Local2024

# --- Test support ---
# Enables the X-Test-Fault header used to prove transactional rollback. Ignored when APP_ENV=production.
ENABLE_TEST_HOOKS=true
# Defect laboratory: leave empty for the correct application. See docs/defect-lab.md.
DEFECT_MODE=
